#!/bin/bash
set -e

APP_DIR="/opt/qlh-edge-inference"
ENV_STATE_DIR="/etc/qlh-edge-inference"
ENV_STATE_FILE="$ENV_STATE_DIR/env-register"
ENV_PROFILE_FILE="/etc/profile.d/qlh.sh"

case "$1" in
    remove|purge|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    *)
        echo "postrm: 未知动作 $1，跳过。"
        exit 0
        ;;
esac

echo "QLH 边缘推理系统 — 卸载后清理..."

# 移除 /usr/local/bin 符号链接（仅 remove/purge，upgrade 时保留）
if [ "$1" != "upgrade" ] && [ "$1" != "failed-upgrade" ]; then
    rm -f /usr/local/bin/qlh-launcher
    rm -f /usr/local/bin/bjtu
    rm -f "$ENV_PROFILE_FILE"
fi

# purge only removes the package tree.  UP-N6.4 data was retained externally;
# deletion of user-owned data requires a separate explicit workflow.
if [ "$1" = "purge" ]; then
    echo "purge: 清理程序目录 $APP_DIR ..."
    rm -rf "$APP_DIR"
    rm -f "$ENV_STATE_FILE"
    rmdir "$ENV_STATE_DIR" 2>/dev/null || true
fi

echo "QLH 边缘推理系统已卸载。"
if [ "$1" != "purge" ]; then
    echo "注意: 用户数据已保留在 /var/lib/qlh-edge-inference/data。"
    echo "重装同一 QLH 包会自动重新关联这些数据。"
fi
