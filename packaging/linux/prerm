#!/bin/bash
set -e

APP_DIR="/opt/qlh-edge-inference"
DATA_ROOT="/var/lib/qlh-edge-inference/data"

case "$1" in
    remove|purge|upgrade|deconfigure)
        ;;
    *)
        echo "prerm: 未知动作 $1，跳过。"
        exit 0
        ;;
esac

echo "QLH 边缘推理系统 — 卸载前清理..."

# 停止 systemd 服务（仅 remove/purge，upgrade 时保持运行）
if [ "$1" != "upgrade" ]; then
    if systemctl is-active --quiet qlh-edge-inference 2>/dev/null; then
        systemctl stop qlh-edge-inference || true
    fi
    if systemctl is-enabled --quiet qlh-edge-inference 2>/dev/null; then
        systemctl disable qlh-edge-inference || true
    fi

    # 停止任何仍在运行的实例
    if command -v pkill &> /dev/null; then
        pkill -f "uvicorn.*api_server" || true
    fi

    # UP-N6.4: refuse uninstall if the constrained data handoff cannot finish.
    # This operation never merges directories or reads user-data contents.
    RETENTION_TOOL="$APP_DIR/bin/data_retention.py"
    RETENTION_PYTHON="$APP_DIR/venv/bin/python3"
    if [ ! -x "$RETENTION_PYTHON" ] || [ ! -f "$RETENTION_TOOL" ]; then
        echo "错误: 数据保留工具缺失；已取消卸载以保护用户数据。" >&2
        exit 1
    fi
    QLH_DATA_DIR="$DATA_ROOT" "$RETENTION_PYTHON" "$RETENTION_TOOL" retain \
        --root "$APP_DIR" --yes --json
fi

echo "卸载前清理完成。"
