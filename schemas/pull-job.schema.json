{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://qlh.dev/schemas/pull-job.schema.json",
  "title": "QLH 模型下载任务（M0 冻结，2026-08-06）",
  "description": "pull job 状态机。下载成功不等于已注册/可加载；终止态后不允许再写进度。",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "job_id",
    "idempotency_key",
    "state",
    "source",
    "progress",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "job_id": { "type": "string", "minLength": 1 },
    "idempotency_key": { "type": "string", "minLength": 1 },
    "state": {
      "enum": [
        "queued",
        "resolving",
        "downloading",
        "verifying",
        "adapting",
        "registered",
        "failed",
        "cancelled",
        "rejected",
        "quarantined",
        "rolled_back"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["provider", "requested_revision"],
      "properties": {
        "provider": {
          "enum": ["huggingface", "gguf_huggingface", "local_directory", "modelscope"]
        },
        "repo_id": { "type": "string" },
        "requested_revision": { "type": "string" },
        "resolved_revision": { "type": ["string", "null"] },
        "allow_patterns": { "type": ["array", "null"], "items": { "type": "string" } }
      }
    },
    "cancel_policy": {
      "enum": ["keep_partial", "cleanup"]
    },
    "progress": {
      "type": "object",
      "additionalProperties": true,
      "required": ["total_bytes", "downloaded_bytes", "files_total", "files_done"],
      "properties": {
        "total_bytes": { "type": "integer", "minimum": 0 },
        "downloaded_bytes": { "type": "integer", "minimum": 0 },
        "files_total": { "type": "integer", "minimum": 0 },
        "files_done": { "type": "integer", "minimum": 0 },
        "current_file": { "type": ["string", "null"] },
        "restart_count": { "type": "integer", "minimum": 0 },
        "transfer_attempt": { "type": "integer", "minimum": 0 },
        "transfer_retry_count": { "type": "integer", "minimum": 0 },
        "resumed_bytes": { "type": "integer", "minimum": 0 },
        "last_retry_error": { "type": ["string", "null"] }
      }
    },
    "artifact_id": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "runtime_check": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "status": {
          "enum": ["ready", "load_failed", "resource_rejected", "stale"]
        },
        "node_id": { "type": "string" },
        "runtime_profile": { "type": "string" },
        "runtime_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
