{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://qlh.dev/schemas/migration-map.schema.json",
  "title": "QLH 模型/集群配置一次性迁移映射（M0 冻结，2026-08-06）",
  "description": "旧事实源（Python 内置注册表 / control-svc JSON / PostgreSQL cluster_config）到 control-svc SQLite 的迁移映射清单。迁移必须幂等且可重复执行，不产生重复 artifact。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources", "target_tables", "rules"],
  "properties": {
    "schema_version": { "const": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id", "location", "role", "id_field",
          "idempotency", "target"
        ],
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "location": { "type": "string", "minLength": 1 },
          "role": {
            "enum": ["curated_catalog_seed", "user_registry", "cluster_settings"]
          },
          "id_field": { "type": "string", "minLength": 1 },
          "idempotency": { "type": "string", "minLength": 1 },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": ["table", "field_map"],
            "properties": {
              "table": { "type": "string", "minLength": 1 },
              "field_map": {
                "type": "object",
                "additionalProperties": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "target_tables": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
