{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://qlh.dev/schemas/fetcher-progress.schema.json",
  "title": "model-fetcher 结构化进度协议（M0 冻结，2026-08-06）",
  "description": "独立 model-fetcher 工具进程 → control-svc 的单向结构化事件（stdout JSON 行 / 内部管道）。fetcher 只做下载与静态校验，不导入推理环境；control-svc 是唯一收件人。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event", "job_id", "phase", "at"],
  "properties": {
    "schema_version": { "const": 1 },
    "event": {
      "enum": ["started", "progress", "resolved", "verified", "failed", "completed"]
    },
    "job_id": { "type": "string", "minLength": 1 },
    "phase": {
      "enum": ["resolving", "downloading", "verifying", "done"]
    },
    "at": { "type": "string", "format": "date-time" },
    "resolved_revision": { "type": ["string", "null"] },
    "total_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "downloaded_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "files_total": { "type": ["integer", "null"], "minimum": 0 },
    "files_done": { "type": ["integer", "null"], "minimum": 0 },
    "current_file": { "type": ["string", "null"] },
    "disk_required_bytes": { "type": ["integer", "null"], "minimum": 0 },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
