        "5a4aafafdac73937077df2bb2378b4b15fa5320ce7b6adb83fb90f44ad60f924",
        "--result-file",
        "{out_dir}/{experiment_id}.result.json",
        "--seed",
        "20260816",
        "--max-new-tokens",
        "192",
        "--n-ctx",
        "2048",
        "--n-gpu-layers",
        "0"
