{
  "plan_id": "plan-quality-total-gate-v1",
  "title": "EX-N3 质量总 gate 实跑（三侧真实证据收口）",
  "prompt_set": {
    "id": "ps-v1-zh-en-code",
    "sha256": "8cc555f57fa23d45c16820f77cc90b507da04578a1e90eebf46e19d4eb2568a3"
  },
  "env": {
    "engine": "llm llama-cpp local GGUF + SD report collector + Gemma Ollama judge",
    "gpu": "gemma judge via local Ollama; llm CPU",
    "notes": "EX-N3 total-gate run: LLM format (non-R1 floor 0.30, correctness floor 0.0 per decision 2026-08-13 plan 1), SD automatic gate (real 90s report), Gemma real 10-image judge (topic 0.70 / coverage 0.40). quality.required=true."
  },
  "quality": {
    "required": true,
    "llm": {
      "prompt_set_id": "ps-v1-zh-en-code",
      "prompt_set_sha256": "8cc555f57fa23d45c16820f77cc90b507da04578a1e90eebf46e19d4eb2568a3",
      "objective_subset_count": 15,
      "objective_prompt_ids": ["math-001", "math-002", "math-004", "math-005", "en-001", "code-001", "code-002", "code-003", "code-004", "code-005", "fmt-001", "fmt-002", "fmt-003", "fmt-004", "fmt-005"],
      "rubric_id": "llm-objective-ps-v1-v1",
      "rubric_sha256": "5a4aafafdac73937077df2bb2378b4b15fa5320ce7b6adb83fb90f44ad60f924",
      "correctness_rate_baseline": 0.0,
      "format_rate_baseline": 0.30,
      "compare_rule": ">= baseline*0.9"
    },
    "sd": {
      "asset_ids": ["sd15_90s_retrovers_v1"],
      "gate": "quality_gate_sd15 automatic_gate.passed"
    },
    "gemma_judge": {
      "model": "gemma4:12b",
      "judge_contract_id": "gemma-judge-counts-v1",
      "judge_contract_sha256": "593c93446cc04553a2c058f36b988aee53b3c994ff92dde9d1539bcf81144b88",
      "topic_hit_rate_baseline": 0.70,
      "key_element_coverage_baseline": 0.40
    },
    "manual_review": {
      "reviewers_required": 2,
      "upgrade_on": "2 pass, 0 fail"
    }
  },
  "defaults": {
    "runs": 1,
    "timeout_s": 3600,
    "max_retries": 0,
    "resources": {
      "cpu_model_slot": "qwen-1_8b-gguf"
    }
  },
  "units": [
    {
      "experiment_id": "exp-0001",
      "name": "LLM 格式率（Qwen 1.8B Q4 客观子集 15 题）",
      "command": [
        "{python}",
        "scripts/experiment_llm_quality_unit.py",
