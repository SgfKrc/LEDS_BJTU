{
  "plan_id": "plan-model-fleet-memory-transport-v1",
  "title": "MF-MEM-N1 固定 tile CUDA 传输矩阵",
  "prompt_set": {
    "id": "ps-v1-zh-en-code",
    "sha256": "8cc555f57fa23d45c16820f77cc90b507da04578a1e90eebf46e19d4eb2568a3"
  },
  "env": {
    "os": "Windows 11 WDDM",
    "cpu": "x86_64",
    "gpu": "NVIDIA GeForce RTX 4060 Laptop 8GB",
    "ram_gb": 16,
    "engine": "isolated synthetic CUDA transport harness",
    "torch": "2.13.0+cu126",
    "cuda": "12.6"
  },
  "defaults": {
    "runs": 8,
    "timeout_s": 600,
    "max_retries": 0,
    "resources": {
      "gpu": "gpu0",
      "memory_transport": "exclusive"
    }
  },
  "units": [
    {
      "experiment_id": "exp-0101",
      "name": "64 MiB pageable baseline",
      "command": ["python", "-X", "utf8", "scripts/model_fleet_memory_transport.py", "--tile-mib", "64", "--mode", "pageable", "--iterations", "8", "--warmup", "2", "--compute-ms", "20", "--result-file", "{out_dir}/{experiment_id}.result.json"],
      "params": {"independent_variable": {"tile_mib": 64, "mode": "pageable", "slots": 1, "compute_ms": 20}},
      "model": {"id": "synthetic-read-only-weight-tile", "quant_family": null},
      "gate": {"metric": "completed", "op": "==", "threshold": 1}
    },
    {
