-    cparams.embeddings_layer_inp.resize(hparams.n_layer(), false);
-    embd_layer_inp.resize(hparams.n_layer());
+    // ★ QLH 2026-09-23：**多留一个槽位**（索引 == `n_layer`）用于导出「末层输出（`output_norm`
+    //   之前）」—— 语义上就是「第 `n_layer` 层的输入」，也就是下游层段（裁层模型保留
+    //   blk.K..N-1）所期望的输入形态。
+    //   为什么必须新增通道：qwen35.cpp 的 `t_h_nextn` 设在 `output_norm` **之后**（那里的
+    //   消费方是 MTP head），拿它当层段上游会多一次 RMSNorm ⇒ 接力数值分叉（实测 9B 首步）。
+    //   `lid == hparams.n_layer()` 是这一槽位的**唯一合法用法**（该层不存在，只能放"末层之后"）。
+    cparams.embeddings_layer_inp.resize(hparams.n_layer() + 1, false);
+    embd_layer_inp.resize(hparams.n_layer() + 1);
 
     cparams.ctx_type     = params.ctx_type;
     cparams.pooling_type = params.pooling_type;
@@ -1148,7 +1154,7 @@ void llama_context::set_embeddings_nextn(bool value, bool masked) {
 void llama_context::set_embeddings_layer_inp(uint32_t lid, bool enable) {
     LLAMA_LOG_DEBUG("%s: lid = %d, enable = %d\n", __func__, lid, enable);
 
