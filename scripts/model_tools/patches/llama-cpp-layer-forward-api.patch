@@ -69,6 +69,17 @@ llama_model_qwen2::graph::graph(const llama_model & model, const llm_graph_param
     ggml_tensor * inp_out_ids = build_inp_out_ids();
 
     for (int il = 0; il < n_layer; ++il) {
+        // ★ QLH 2026-09-20（层段接力 / C+ 验证）：登记「进入本层的张量」，
+        //   供 `llama_get_embeddings_layer_inp(ctx, il)` 导出（需先用
+        //   `llama_set_embeddings_layer_inp(ctx, il, true)` 打开）。
+        //   语义：这是**未经 attn_norm/ffn_norm** 的层输入，也就是**上一层输出的原样**。
+        //   ⇒ 「layer_inp(K)」= 「原模型 blk.(K-1) 的输出」= **裁层模型
+        //   （保留 blk.K..blk.N-1 并重编号为 blk.0..）的 blk.0 所期望的输入**。
+        //   与 qwen3.cpp / qwen35.cpp / llama.cpp 等架构写法一致。
+        //   默认不开启导出（cparams.embeddings_layer_inp 全 false），因此对正常
+        //   推理路径零影响：t_layer_inp 只在 set_outputs 里被 ggml_set_output。
+        res->t_layer_inp[il] = inpL;
+
         ggml_tensor * inpSA = inpL;
 
         // norm
@@ -134,6 +145,30 @@ llama_model_qwen2::graph::graph(const llama_model & model, const llm_graph_param
     }
     cur = inpL;
 
+    // ★ QLH 2026-09-23（层段接力上游）：与 qwen35 一致，把「末层输出（`output_norm` 之前）」
+    //   登记到 `t_layer_inp[n_layer]`（"第 n_layer 层的输入"槽位）。本架构的 t_h_nextn 本来
+    //   就在 norm 之前，但为让 shim/Python 只用**一条**通道（不依赖各架构 t_h_nextn 的差异），
+    //   这里同样登记一份。
+    res->t_layer_inp[n_layer] = cur;
+
+    // ★ QLH 2026-09-20（层段接力 / C+ 验证）：把「最后一层的输出」暴露到 t_h_nextn。
+    //
+    // 语义：此处 `cur` 是**未经 output_norm** 的层输出，正是**裁层模型**（保留
+    // blk.K..blk.N-1、重编号为 blk.0..）的 blk.0 所期望的输入形态。有了它，
+    // 上层就能在**同一个模型源码**上构造出「上游 hidden → 下游注入」的接力链，
+    // 而不必依赖较新 fork 才有的 `llama_get_hidden_state`（android 子模块的
+    // llama.cpp 为 b9902，没有该 API）。
+    //
+    // ⚠️ 与 qwen35 的 h_nextn **不是同一个东西**：qwen35.cpp 把 t_h_nextn 设在
+    // `build_norm` **之后**，因为那里的消费方是 MTP head（期望 norm 后）。这里
+    // 的消费方是**下游层段**，期望 norm 前 ⇒ 必须设在 norm 之前。
+    //
+    // ⚠️ 只在 `embeddings_nextn` 打开时才会被读取（见 llama-context.cpp 的
+    // `cparams.embeddings_nextn ? res->get_h_nextn() : nullptr`），因此对正常
+    // 推理路径**零影响**（多出的 tensor 不进 sched、不参与计算）。
+    cb(cur, "h_nextn", -1);
+    res->t_h_nextn = cur;
+
     cur = build_norm(cur,
             model.output_norm, NULL,
             LLM_NORM_RMS, -1);
