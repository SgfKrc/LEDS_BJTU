         ggml_tensor * inpSA = inpL;
 
         // norm
@@ -134,6 +145,24 @@ llama_model_qwen2::graph::graph(const llama_model & model, const llm_graph_param
     }
     cur = inpL;
 
+    // ★ QLH 2026-09-20（层段接力 / C+ 验证）：把「最后一层的输出」暴露到 t_h_nextn。
+    //
+    // 语义：此处 `cur` 是**未经 output_norm** 的层输出，正是**裁层模型**（保留
+    // blk.K..blk.N-1、重编号为 blk.0..）的 blk.0 所期望的输入形态。有了它，
+    // 上层就能在**同一个模型源码**上构造出「上游 hidden → 下游注入」的接力链，
+    // 而不必依赖较新 fork 才有的 `llama_get_hidden_state`（android 子模块的
+    // llama.cpp 为 b9902，没有该 API）。
+    //
+    // ⚠️ 与 qwen35 的 h_nextn **不是同一个东西**：qwen35.cpp 把 t_h_nextn 设在
